# Copy to .env.local and replace placeholders. Never commit credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOSTNAME/DATABASE?retryWrites=true&w=majority
ADMIN_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
CRON_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=notifications@example.com
ADMIN_NOTIFICATION_EMAIL=team@example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_FOUNDED_YEAR=
NEXT_PUBLIC_BROCHURE_URL=
NEXT_PUBLIC_FILM_URL=
# Optional: comma-separated hosts for remote property images.
IMAGE_HOSTS=
# Optional: a client-IP header overwritten by your trusted reverse proxy.
RATE_LIMIT_IP_HEADER=
